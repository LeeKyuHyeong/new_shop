# ===========================================
# 시크릿 설정 템플릿
# ===========================================
# 사용법:
#   1. 이 파일을 application-secret.properties 로 복사
#   2. 각 항목에 실제 값 입력
#   3. application-secret.properties 는 .gitignore 에 포함되어 있으므로 커밋되지 않음
#
# 프로덕션에서는 이 파일 대신 환경변수로 주입하는 것을 권장
# (application-prod.properties 가 환경변수를 읽도록 설정되어 있음)
# ===========================================

# Gmail SMTP (앱 비밀번호 - 2단계 인증 후 발급)
spring.mail.username=YOUR_GMAIL@gmail.com
spring.mail.password=YOUR_APP_PASSWORD

# ===========================================
# 결제 (Portone)
# https://admin.portone.io 에서 발급
# ===========================================
payment.portone.imp-code=YOUR_IMP_CODE
payment.portone.api-key=YOUR_PORTONE_API_KEY
payment.portone.api-secret=YOUR_PORTONE_API_SECRET
payment.test-mode=true

# ===========================================
# 소셜 로그인 OAuth
# ===========================================

# 카카오 (https://developers.kakao.com)
social.kakao.client-id=YOUR_KAKAO_CLIENT_ID
social.kakao.client-secret=YOUR_KAKAO_CLIENT_SECRET
social.kakao.redirect-uri=http://localhost:8081/oauth/kakao/callback

# 네이버 (https://developers.naver.com)
social.naver.client-id=YOUR_NAVER_CLIENT_ID
social.naver.client-secret=YOUR_NAVER_CLIENT_SECRET
social.naver.redirect-uri=http://localhost:8081/oauth/naver/callback

# 구글 (https://console.cloud.google.com)
social.google.client-id=YOUR_GOOGLE_CLIENT_ID
social.google.client-secret=YOUR_GOOGLE_CLIENT_SECRET
social.google.redirect-uri=http://localhost:8081/oauth/google/callback
